# ------------------------------------------------------------------
# Vicinity — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# ---- Core ----
NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://vicinity:vicinity@localhost:5432/vicinity?schema=public
POSTGRES_USER=vicinity
POSTGRES_PASSWORD=vicinity
POSTGRES_DB=vicinity

# ---- Redis (presence + pub/sub) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Local/mock auth secret for signing JWTs during MVP.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# Auth mode: "local" (MVP) or "entra" (future, Microsoft Entra ID).
AUTH_MODE=local
# Entra ID (future) — leave blank for MVP.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- Storage (Azure Blob / S3-compatible) ----
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=vicinity-assets

# ---- WebRTC ----
# Public STUN server(s); add TURN for production NAT traversal.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Frontend (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---- Observability ----
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
