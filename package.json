{
  "name": "vicinity",
  "version": "0.1.0",
  "private": true,
  "description": "Vicinity — an original spatial collaboration / virtual office platform.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema prisma/schema.prisma",
    "prisma:seed": "npx ts-node --project prisma/tsconfig.json prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev:db": "node scripts/pg-server.mjs"
  },
  "dependencies": {
    "prisma": "^5.16.1",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.7.0"
}
